<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Bismillah Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.IslamicZone.HeaderRounded"
            app:cardElevation="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_header_gradient">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_bismi_frame"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="48dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بِسْمِ اللَّهِ الرَّحْمَـٰنِ الرَّحِيمِ"
                        android:textColor="#FFD700"
                        android:textSize="28sp"
                        android:fontFamily="@font/arabic"
                        android:gravity="center"
                        android:shadowColor="#8B6914"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="বিসমিল্লাহির রহমানির রহিম"
                        android:textColor="#FFE97A"
                        android:textSize="13sp"
                        android:fontFamily="@font/bahij"
                        android:gravity="center"
                        android:alpha="0.92" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Date & Location Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bahij" />

                <TextView
                    android:id="@+id/tv_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/bahij" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp"
                    android:fontFamily="@font/bahij" />
            </LinearLayout>
        </LinearLayout>

        <!-- Prayer Flower Widget -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/iv_flower_bg"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_gravity="center"
                android:src="@drawable/img_flower_neutral"
                android:contentDescription="@null" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_background"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/clock_font"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Fajr top -->
                <LinearLayout android:id="@+id/layout_fajr"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.18" app:layout_constraintHorizontal_bias="0.5">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_petal_fajr" android:contentDescription="@null" />
                    <TextView android:id="@+id/tv_fajr_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="ফজর" android:textColor="@color/on_surface" android:textSize="12sp"
                        android:fontFamily="@font/bahij" />
                    <TextView android:id="@+id/tv_fajr_time" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/on_surface"
                        android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Sunrise top-right -->
                <LinearLayout android:id="@+id/layout_sunrise"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.34" app:layout_constraintHorizontal_bias="0.78">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_petal_sunrise" android:contentDescription="@null" />
                    <TextView android:id="@+id/tv_sunrise_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="সূর্যোদয়" android:textColor="@color/on_surface" android:textSize="12sp"
                        android:fontFamily="@font/bahij" />
                    <TextView android:id="@+id/tv_sunrise_time" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/on_surface"
                        android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Dhuhr bottom-right -->
                <LinearLayout android:id="@+id/layout_dhuhr"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.66" app:layout_constraintHorizontal_bias="0.78">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_petal_dhuhr" android:contentDescription="@null" />
                    <TextView android:id="@+id/tv_dhuhr_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="যোহর" android:textColor="@color/on_surface" android:textSize="12sp"
                        android:fontFamily="@font/bahij" />
                    <TextView android:id="@+id/tv_dhuhr_time" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/on_surface"
                        android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Asr bottom -->
                <LinearLayout android:id="@+id/layout_asr"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.82" app:layout_constraintHorizontal_bias="0.5">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_petal_asr" android:contentDescription="@null" />
                    <TextView android:id="@+id/tv_asr_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="আসর" android:textColor="@color/on_surface" android:textSize="12sp"
                        android:fontFamily="@font/bahij" />
                    <TextView android:id="@+id/tv_asr_time" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/on_surface"
                        android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Maghrib bottom-left -->
                <LinearLayout android:id="@+id/layout_maghrib"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.66" app:layout_constraintHorizontal_bias="0.22">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_petal_maghrib" android:contentDescription="@null" />
                    <TextView android:id="@+id/tv_maghrib_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="মাগরিব" android:textColor="@color/on_surface" android:textSize="12sp"
                        android:fontFamily="@font/bahij" />
                    <TextView android:id="@+id/tv_maghrib_time" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/on_surface"
                        android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Isha top-left -->
                <LinearLayout android:id="@+id/layout_isha"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.34" app:layout_constraintHorizontal_bias="0.22">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_petal_isha" android:contentDescription="@null" />
                    <TextView android:id="@+id/tv_isha_label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="ইশা" android:textColor="@color/on_surface" android:textSize="12sp"
                        android:fontFamily="@font/bahij" />
                    <TextView android:id="@+id/tv_isha_time" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/on_surface"
                        android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <!-- Quick Actions -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="20dp"
            android:text="দ্রুত অ্যাক্সেস" android:textColor="@color/on_background"
            android:textSize="17sp" android:textStyle="bold" android:fontFamily="@font/bahij" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_quick_actions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:layout_marginHorizontal="8dp"
            android:clipToPadding="false" />

        <!-- Verse Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp"
            app:cardElevation="4dp" app:strokeColor="@color/secondary_variant" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="আজকের আয়াত" android:textColor="@color/primary"
                    android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/bahij" />

                <TextView android:id="@+id/tv_arabic_verse"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:gravity="end"
                    android:textColor="@color/on_surface" android:textSize="26sp"
                    android:fontFamily="@font/arabic" />

                <TextView android:id="@+id/tv_bangla_verse"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/on_surface"
                    android:textSize="15sp" android:fontFamily="@font/bahij" />

                <TextView android:id="@+id/tv_verse_reference"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#757575" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Goals -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="4dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="দৈনিক লক্ষ্য" android:textColor="@color/primary"
                    android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/bahij" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="ফজর"
                        app:chipIcon="@drawable/ic_check_success" app:chipIconTint="@color/on_primary"
                        app:chipIconVisible="true" android:textColor="@color/on_primary"
                        app:chipBackgroundColor="@color/success" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="কুরআন" app:chipBackgroundColor="@color/warning" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="আজকার" app:chipBackgroundColor="@color/divider" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
